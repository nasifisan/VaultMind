<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Clear all inherited/global package sources to prevent hangs on unreachable private feeds -->
    <clear />
    <!-- Only use the official public NuGet gallery for this project -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
